# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# .env is loaded automatically by Docker Compose and by most local dev
# tools. NEVER commit .env to git (it's already in .dockerignore and
# should be in .gitignore too).

# ---------- Database ----------
# Password used by the MariaDB root account. Also used by the web app
# to connect (DB_USER defaults to root).
DB_PASSWORD=rootpass

# The application database name. The entrypoint creates it on first boot.
DB_NAME=profile_system

# DB host as seen by the web container. Don't change this unless you
# know what you're doing — it must match the service name in compose.yml.
DB_HOST=profile_db

# DB port (the internal one inside the container; the host-side port
# mapping is in compose.yml under `ports:`).
DB_PORT=3306

# Application DB user. Defaults to root, which is fine for local dev.
# For production, create a dedicated user with limited privileges and
# update GRANTs in docker/db-init/00-bootstrap.sql.
DB_USER=root

# Dedicated, least-privilege user for the application. Leave empty
# to fall back to DB_USER. The web entrypoint creates this user on
# first boot.
# APP_DB_USER=profile_app
# DB_APP_PASSWORD=change-me-too

# ---------- Web server ----------
# Host port mapped to the web container's port 80.
#   WEB_PORT=8080  -> http://localhost:8080
#   WEB_PORT=9000  -> http://localhost:9000
WEB_PORT=8080

# ---------- Hardening (for public / tunnel exposure) ----------
# When exposing the app via a Cloudflare tunnel or the public internet,
# override the defaults below. See docs/TUNNEL.md.

# Mark the session cookie as Secure (0=auto/disabled, 1=force on).
# COOKIE_SECURE=0

# Trust X-Forwarded-* from an upstream reverse proxy (0=off, 1=on).
# Required behind Cloudflare so the app sees the real scheme + IP.
# TRUST_PROXY=0
#
# Which network interface the web port listens on. With TRUST_PROXY=1 set
# this to 127.0.0.1: the tunnel connects from this machine, and nobody on
# the network can reach the app directly and fake their IP address.
# WEB_BIND=0.0.0.0

# Runtime environment. Set to "production" before any public exposure.
# APP_ENV=development

# Public address of the site, used for links in emails. REQUIRED in
# production (without it no email with a link is sent, so a forged Host
# header can never redirect a reset link). In development it falls back
# to the address in the browser.
# APP_URL=https://profiles.example.ac.jp

# ---------- Email (invitations, password reset, security notices) ----------
# Leave MAIL_HOST empty to turn email off (development then shows reset
# links on screen; invitations are always shown to copy).
#
# Local testing with Mailpit (catches every email; inbox at
# http://localhost:8025 after `make mail`):
#   MAIL_HOST=mailpit
#   MAIL_PORT=1025
#   MAIL_ENCRYPTION=none
#   MAIL_FROM_ADDRESS=noreply@example.test
#
# Real sending: use your university's SMTP server or a provider
# (Brevo, Resend, SendGrid, Amazon SES, Gmail/Google Workspace with an
# app password). Typical values:
#   MAIL_HOST=smtp.example.ac.jp
#   MAIL_PORT=587             # 587 = STARTTLS (MAIL_ENCRYPTION=tls), 465 = SSL (ssl)
#   MAIL_ENCRYPTION=tls
#   MAIL_USERNAME=lab-profiles@example.ac.jp
#   MAIL_PASSWORD=change-me
#   MAIL_FROM_ADDRESS=lab-profiles@example.ac.jp   # must be allowed to send from this server
#   MAIL_FROM_NAME=Lab Profile System
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Profile System

# Time zone used until an admin picks one in Admin › Site settings (which
# then wins). Any name from the tz database, e.g. Asia/Tokyo. Default: UTC.
# APP_TIMEZONE=UTC

# Whether to start Adminer (0=off, 1=on). Leave 0 for any non-local use.
# ENABLE_ADMINER=0

# Host port for the Adminer container (only when ENABLE_ADMINER=1).
# ADMINER_PORT=8081