# ---- Secrets and local config: never commit ----
.env
.env.*
!.env.example

# ---- Dependencies (built files in public/assets ARE committed) ----
node_modules/

# ---- User uploads: keep only the .htaccess that blocks PHP execution ----
public/uploads/*
!public/uploads/.htaccess

# ---- Generated by `make backup` (database dumps + uploads) and old code snapshots ----
backups/
*.sql.gz
*.dump

# ---- Cloudflare tunnel scratch files (the log contains the public URL) ----
cloudflared.log
cloudflared.pid

# ---- Test scripts that contain real login credentials ----
# Move the email/password into environment variables before un-ignoring.
crud_test.sh
docker/smoke.sh
public/docker/smoke.sh

# ---- Logs / scratch ----
*.log
*.bak
*.tmp
test_db.php
_diag.php
docker-compose.override.yml

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini
