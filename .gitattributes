# Keep Linux line endings on files that run inside the Linux containers,
# even on Windows with core.autocrlf=true. A shell script with CRLF fails
# with "bash\r: No such file or directory" and the web container won't start.
* text=auto
*.sh       text eol=lf
*.sql      text eol=lf
*.php      text eol=lf
*.conf     text eol=lf
*.ini      text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
compose.yml text eol=lf
.env.example text eol=lf

# Binary
*.woff2 binary
*.png   binary
*.jpg   binary
